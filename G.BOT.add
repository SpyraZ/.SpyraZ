<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Redirecting to Discord...</title>
    
    <meta http-equiv="refresh" content="0; url=https://discord.com/oauth2/authorize?client_id=1521073549723308092&permissions=8&integration_type=0&scope=bot">
    
    <style>
        body {
            font-family: 'GG Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
            background-color: #313338; /* Discord dark theme background */
            color: #dbdee1;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .card {
            text-align: center;
            background-color: #2b2d31;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }
        h1 {
            font-size: 24px;
            color: #ffffff;
            margin-bottom: 10px;
        }
        p {
            font-size: 16px;
        }
        a {
            color: #5865f2; /* Discord Blurple */
            text-decoration: none;
            font-weight: bold;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>Connecting to Discord...</h1>
        <p>If you are not redirected automatically, <a href="https://discord.com/oauth2/authorize?client_id=1521073549723308092&permissions=8&integration_type=0&scope=bot">click here</a>.</p>
    </div>

    <script>
        setTimeout(function() {
            window.location.href = "https://discord.com/oauth2/authorize?client_id=1521073549723308092&permissions=8&integration_type=0&scope=bot";
        }, 100);
    </script>
</body>
</html>
